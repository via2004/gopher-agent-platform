DATABASE_URL=
JWT_SECRET=
HTTP_ADDR=127.0.0.1:8080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://ai.novacode.top/
OPENAI_WIRE_API=responses
OPENAI_REQUIRES_AUTH=true
OPENAI_REASONING_EFFORT=low
OPENAI_DISABLE_RESPONSE_STORAGE=true

MCP_SERVER_URL=
MCP_CALL_TIMEOUT_SECONDS=10
MCP_HTTP_ADDR=127.0.0.1:8081
WEATHER_API_BASE_URL=https://wttr.in
WEATHER_API_TIMEOUT_SECONDS=5

BAIDU_TTS_API_KEY=
BAIDU_TTS_SECRET_KEY=
BAIDU_TTS_BASE_URL=https://aip.baidubce.com
BAIDU_TTS_TIMEOUT_SECONDS=10
TTS_RATE_LIMIT=5
TTS_RATE_WINDOW_SECONDS=3600

CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60

REDIS_URL="redis://127.0.0.1:6379/0"
RABBITMQ_URL=amqp://gopherai:gopherai-dev@127.0.0.1:5672/gopherai
CHAT_JOB_MAX_ATTEMPTS=5

ONNXRUNTIME_SHARED_LIBRARY_PATH=./models/onnxruntime/onnxruntime-linux-x64-1.22.0/lib/libonnxruntime.so.1.22.0
IMAGE_MODEL_PATH=./models/mobilenetv2-7.onnx
IMAGE_LABELS_PATH=./models/imagenet_classes.txt

RAG_STORAGE_ROOT=./data/rag
RAG_UPLOAD_RATE_LIMIT=3
RAG_UPLOAD_RATE_WINDOW_SECONDS=3600

OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=text-embedding-v4
OPENAI_EMBEDDING_REQUIRES_AUTH=true

EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=GopherAI
SMTP_TIMEOUT_SECONDS=10

AUTH_REGISTER_RATE_LIMIT=10
AUTH_REGISTER_RATE_WINDOW_SECONDS=600
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
EMAIL_VERIFICATION_IP_RATE_LIMIT=10
EMAIL_VERIFICATION_IP_RATE_WINDOW_SECONDS=3600
