# Copy this file to .env.compose and fill in provider credentials.
# Container-internal database, Valkey, RabbitMQ and MCP URLs are set by compose.yaml.

JWT_SECRET=replace-with-at-least-32-random-bytes

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://ai.novacode.top/
OPENAI_WIRE_API=responses
OPENAI_REQUIRES_AUTH=true
OPENAI_REASONING_EFFORT=low
OPENAI_DISABLE_RESPONSE_STORAGE=true

MCP_CALL_TIMEOUT_SECONDS=10

BAIDU_TTS_API_KEY=
BAIDU_TTS_SECRET_KEY=
BAIDU_TTS_BASE_URL=https://aip.baidubce.com
BAIDU_TTS_TIMEOUT_SECONDS=10
TTS_RATE_LIMIT=5
TTS_RATE_WINDOW_SECONDS=3600

OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=text-embedding-v4
OPENAI_EMBEDDING_REQUIRES_AUTH=true

CHAT_JOB_MAX_ATTEMPTS=5
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60
RAG_UPLOAD_RATE_LIMIT=3
RAG_UPLOAD_RATE_WINDOW_SECONDS=3600
